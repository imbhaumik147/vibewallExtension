{
  "manifest_version": 3,
  "name": "VibeWall",
  "version": "1.0.0",
  "description": "A customizable, modern dashboard for your New Tab.",
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_title": "VibeWall"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
